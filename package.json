{
  "name": "dsh-bili-interact",
  "version": "0.0.6",
  "description": "dsh-bili-scroll 的伴随插件：给 B站 视频点赞 / 收藏 / 转发 / 关注 / 发动态。写操作默认关，每个动作都有代码级每日硬上限 —— 为了防止大肥鱼沉迷b站。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "annasleepy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/annasleepy/dsh-bili-interact.git"
  },
  "homepage": "https://github.com/annasleepy/dsh-bili-interact#readme",
  "bugs": {
    "url": "https://github.com/annasleepy/dsh-bili-interact/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "bilibili"
  ],
  "peerDependencies": {
    "dsh-bili-scroll": ">=0.1.0 <0.3.0",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "python",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/edge.mjs",
    "test:live": "BILI_LIVE=1 node test/live.mjs"
  }
}
